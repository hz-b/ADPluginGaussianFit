record(mbbi, "$(P)$(R)Termination")
{
    field(DTYP, "asynInt32")
    field(INP,  "@asyn($(PORT),$(ADDR=0),$(TIMEOUT))TERMINATION")
    field(ZRST, "CONVERGENCE")
    field(ZRVL, "0")
    field(ONST, "NO_CONVERGENCE")
    field(ONVL, "1")
    field(TWST, "FAILURE")
    field(TWVL, "2")
    field(THST, "USER_SUCCESS")
    field(THVL, "3")
    field(FRVL, "USER_FAILURE")
    field(FRVL, "4")
    field(SCAN, "I/O Intr")
}

