# include the base driver template file
include "NDPluginBase.template"

record(ao, "$(P)$(R)Initial_Amplitude")
{
    field(PINI,  "YES")
    field(DTYP,  "asynFloat64")
    field(OUT,   "@asyn($(PORT),$(ADDR),$(TIMEOUT))INITIAL_AMPLITUDE")
    field(VAL,   "255.0")
}

